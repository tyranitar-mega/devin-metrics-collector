FROM (
  FROM scopedb.devin_cli.metrics
  WHERE metric_name = 'devin.token.usage'
    AND recorded_at >= NOW() - 'PT168H'::interval
  GROUP BY model
  AGGREGATE
    SUM(CASE attribute_type WHEN 'input' THEN value ELSE 0.0 END) AS input_tokens,
    SUM(CASE attribute_type WHEN 'cacheRead' THEN value ELSE 0.0 END) AS cache_read_tokens,
    SUM(CASE attribute_type WHEN 'cacheCreation' THEN value ELSE 0.0 END) AS cache_creation_tokens,
    SUM(CASE attribute_type WHEN 'output' THEN value ELSE 0.0 END) AS output_tokens
) AS usage
