# ScopeDB Cloud workspace data-plane endpoint. Copy it from `scope workspace get`
# or the Console; do not append /v1/statements.
TELESCOPE_SCOPEDB_ENDPOINT=

# Workspace API key created with `scope api-key create`. Never commit the real value.
TELESCOPE_SCOPEDB_API_KEY=

# Host port for Devin CLI's OTLP/HTTP metrics endpoint.
TELESCOPE_OTLP_HTTP_PORT=4318

# Keep loopback for local Devin CLI use. Set to 0.0.0.0 only behind a trusted network or TLS proxy.
TELESCOPE_OTLP_HTTP_BIND=127.0.0.1

# Operational status endpoint stays on loopback by default.
TELESCOPE_HTTP_PORT=8080
TELESCOPE_HTTP_BIND=127.0.0.1

# Optional delivery tuning.
TELESCOPE_QUEUE_MAX_BYTES=268435456
TELESCOPE_QUEUE_CONSUMERS=1
TELESCOPE_WRITE_TIMEOUT=30s
TELESCOPE_APPEND_MAX_ROWS=8000
TELESCOPE_APPEND_MAX_BYTES=4194304
TELESCOPE_OTEL_BATCH_SIZE=2000
TELESCOPE_OTEL_BATCH_MAX_SIZE=2000
TELESCOPE_OTEL_BATCH_TIMEOUT=10s

# Pin the Telescope release/image.
TELESCOPE_IMAGE=ghcr.io/scopedb/telescope:v0.4.0
